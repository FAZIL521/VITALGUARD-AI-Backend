# VITALGUARD emergency alert configuration
# NEVER commit real credentials to GitHub.

ALERTS_ENABLED=false

# Primary and optional secondary emergency contacts in E.164 format.
# Example: +919876543210
EMERGENCY_CONTACT=
EMERGENCY_CONTACT_2=

# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Anti-spam / false-trigger controls
ALERT_CONFIDENCE_THRESHOLD=0.75
ALERT_COOLDOWN_SECONDS=600
